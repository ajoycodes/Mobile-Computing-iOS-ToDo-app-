rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can only see and change the tasks under their own uid.
    match /users/{userId}/tasks/{taskId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isValidTask() {
        let task = request.resource.data;
        return task.keys().hasOnly(['title', 'description', 'createdAt', 'updatedAt'])
          && task.title is string
          && task.title.size() > 0
          && task.title.size() <= 100
          && task.description is string
          && task.description.size() <= 1000
          && task.updatedAt == request.time;
      }

      allow read, delete: if isOwner();

      allow create: if isOwner()
        && isValidTask()
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner()
        && isValidTask()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Everything else is closed.
  }
}
